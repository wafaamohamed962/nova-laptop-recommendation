# Base URL of the deployed Modal vLLM server, e.g.
# https://<your-workspace>--laptop-recommender-llm-serve.modal.run/v1
VLLM_BASE_URL=

# Must match the value stored in the "laptop-recommender-vllm-key" Modal secret
VLLM_API_KEY=

VLLM_SERVED_MODEL_NAME=qwen2.5-7b-instruct

# SerpApi key (https://serpapi.com) -- used by Phase 5's live_price_tool to
# fetch current prices/sellers/ratings/links for the top 3 recommended
# laptops via the Google Shopping engine.
SERPAPI_API_KEY=
