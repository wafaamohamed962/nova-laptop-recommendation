# Base URL of the backend API (LangGraph/RAG/recommendation service).
# Not used while VITE_USE_MOCK_API=true.
VITE_API_BASE_URL=https://api.example.com

# When "true" (default), the frontend uses the local mock chat service
# and no network requests are made. Set to "false" once the real
# backend at VITE_API_BASE_URL is available.
VITE_USE_MOCK_API=true
